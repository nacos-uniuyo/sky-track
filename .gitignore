# ============================================================
# Sky Track - .gitignore
# Copy this file into any clone to reproduce the exact same
# local project structure. Each section explains what is
# ignored and why.
# ============================================================

# --- Agent / skill tooling (NOT part of the app) ---
# .agents/ holds agent skills and planning files used only by
# the dev tooling on the author's machine. Students don't need them.
.agents/
# skills-lock.json pins the agent skill registry. Not app code.
skills-lock.json

# --- Maven build output ---
# target/ is generated by Maven (compiled classes, jars, reports).
# It must never be committed - regenerate with `mvn package`.
target/
**/target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar

# --- Environment & secrets ---
# .env holds your real OpenWeatherMap API key. NEVER commit it.
# Copy .env.example to .env and fill in your own key.
.env

# --- IDE files (personal, machine-specific) ---
.idea/
*.iml
.vscode/

# --- OS junk ---
.DS_Store
*.swp
*.swo
*~
Thumbs.db

# --- Logs ---
logs/
*.log
